    {
        "id": "769b9059cbb10d79",
        "type": "function",
        "z": "48d760205da3975c",
        "name": "Parse Sensor Data",
        "func": "let data = msg.payload.toString();\n\nlet tempMatch = data.match(/Temperature:\\s*(\\d+)/);\nlet humidityMatch = data.match(/Humidity:\\s*(\\d+)/);\n\nif (!tempMatch || !humidityMatch) {\n    return null;\n}\n\nlet temperature = Number(tempMatch[1]);\nlet humidity = Number(humidityMatch[1]);\n\nreturn [\n    { payload: temperature },\n    { payload: humidity }\n];",
        "outputs": 2,
